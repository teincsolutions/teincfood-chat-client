{
  "name": "@teincfood/chat-client",
  "version": "0.1.0",
  "description": "Shared chat client for TeincFood apps - Phoenix Channels WebSocket with persistent storage and optimistic messaging",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./adapters/memory": {
      "import": "./dist/adapters/memory-adapter.js",
      "types": "./dist/adapters/memory-adapter.d.ts"
    },
    "./adapters/indexeddb": {
      "import": "./dist/adapters/indexeddb-adapter.js",
      "types": "./dist/adapters/indexeddb-adapter.d.ts"
    },
    "./adapters/mmkv": {
      "import": "./dist/adapters/mmkv-adapter.js",
      "types": "./dist/adapters/mmkv-adapter.d.ts"
    },
    "./react": {
      "import": "./dist/react/use-chat.js",
      "types": "./dist/react/use-chat.d.ts"
    },
    "./text-parser": {
      "import": "./dist/text-parser.js",
      "types": "./dist/text-parser.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "node --import tsx src/__tests__/live-test.ts"
  },
  "keywords": [
    "phoenix",
    "channels",
    "websocket",
    "chat",
    "teincfood"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/phoenix": "^1.6.7",
    "@types/react": "^19.2.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "phoenix": "^1.8.8"
  }
}
